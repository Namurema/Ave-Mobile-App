// Cloudflare (Workers with static assets) hosting for the Ave web app.
// The build (see the Cloudflare dashboard) runs the prayer snapshot and the
// Expo web export into ./dist; this serves those files. Every page is the same
// single-page app, so unknown paths get index.html. Response headers come from
// public/_headers.
{
  "name": "ave-prayers",
  "compatibility_date": "2026-10-01",
  // Only aveprayers.com serves the app (no *.workers.dev address)
  "workers_dev": false,
  // aveprayers.com and www (Cloudflare creates the DNS records and certificate)
  "routes": [
    { "pattern": "aveprayers.com", "custom_domain": true },
    { "pattern": "www.aveprayers.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
